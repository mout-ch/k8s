{
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    ":automergeDigest",
    ":automergeBranch"
  ],
  "forkProcessing": "enabled",
  "timezone": "Europe/Zurich",
  "schedule": [
    "* 0-5 * * 1-5"
  ],
  "labels": [
    "dependencies"
  ],
  "commitMessagePrefix": "chore(deps): ",
  "prConcurrentLimit": 10,
  "prHourlyLimit": 2,
  "packageRules": [
    {
      "description": "Group Helm chart dependencies",
      "matchManagers": [
        "helm-values",
        "helmv3"
      ],
      "groupName": "helm-charts",
      "commitMessageTopic": "Helm charts"
    },
    {
      "description": "Group Docker images in Kubernetes manifests",
      "matchManagers": [
        "kubernetes"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "k8s-images",
      "commitMessageTopic": "Kubernetes images"
    },
    {
      "description": "Auto-merge patch and digest updates",
      "matchUpdateTypes": [
        "digest",
        "patch"
      ],
      "automerge": true,
      "automergeType": "branch"
    },
    {
      "description": "Critical security updates",
      "matchPackageNames": [
        "cert-manager",
        "prometheus",
        "grafana"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "labels": [
        "security",
        "major-update"
      ],
      "reviewersFromCodeOwners": true
    },
    {
      "description": "ArgoCD and infrastructure tools",
      "matchPackageNames": [
        "argo-cd",
        "authentik",
        "vault-secrets-operator"
      ],
      "groupName": "infrastructure",
      "labels": [
        "infrastructure"
      ],
      "schedule": [
        "* 0-3 * * 0"
      ]
    },
    {
      "description": "Media stack updates",
      "matchPackageNames": [
        "jellyfin",
        "seerr",
        "radarr",
        "sonarr",
        "jackett",
        "qbittorrent",
        "home-assistant",
        "zigbee2mqtt",
        "immich",
        "adguard-home"
      ],
      "groupName": "media-stack",
      "labels": [
        "media-stack"
      ],
      "commitMessageTopic": "Media stack"
    },
    {
      "description": "ceph-csi 3.16 is tested on k8s 1.32-1.34; raise along with k3s (3.17.0: 1.33-1.35, 3.17.1/3.18: 1.34-1.36; 3.18 images need x86-64-v3). Upstream recommends ceph-csi-operator from 3.16 on",
      "matchPackageNames": [
        "ceph-csi-rbd"
      ],
      "allowedVersions": "<3.17.0"
    },
    {
      "description": "Minecraft servers",
      "matchPackageNames": [
        "minecraft"
      ],
      "groupName": "minecraft",
      "labels": [
        "minecraft"
      ],
      "schedule": [
        "* 0-5 * * 6"
      ]
    },
    {
      "description": "Immich server and machine-learning must share the same version",
      "matchPackageNames": [
        "/^ghcr\\.io/immich-app//"
      ],
      "groupName": "immich",
      "automerge": false,
      "labels": [
        "media-stack"
      ]
    }
  ],
  "helm-values": {
    "managerFilePatterns": [
      "/(^|/)values\\.ya?ml$/"
    ]
  },
  "helmv3": {
    "managerFilePatterns": [
      "/(^|/)Chart\\.ya?ml$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/\\.ya?ml$/"
    ],
    "ignorePaths": [
      "**/charts/**"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update Git commit hashes in ArgoCD Applications (tracks master)",
      "managerFilePatterns": [
        "/^root/templates/.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "repoURL: (?<packageName>https://github\\.com/[^\\s]+?)(\\.git)?\\s+targetRevision: (?<currentDigest>[a-f0-9]{40})"
      ],
      "depNameTemplate": "{{{replace \"https://github.com/\" \"\" packageName}}}",
      "currentValueTemplate": "master",
      "datasourceTemplate": "git-refs"
    }
  ],
  "ignoreDeps": [
    "ghcr.io/hotio/jackett"
  ],
  "vulnerabilityAlerts": {
    "labels": [
      "security",
      "vulnerability"
    ],
    "assignees": [
      "@rootmout"
    ]
  },
  "argocd": {
    "managerFilePatterns": [
      "/^root/templates/.*\\.ya?ml$/"
    ]
  }
}
